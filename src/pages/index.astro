---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inicio">
  <div class="text-center space-y-6">
    <h1 class="text-4xl font-bold">Sistema de Usuarios</h1>
    <p class="text-gray-400">Registra e inicia sesion para acceder al panel</p>
    <div class="flex gap-4 justify-center">
      <a href="/register" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition">
        Registrarse
      </a>
      <a href="/login" class="px-6 py-3 bg-gray-700 hover:bg-gray-600 rounded-lg font-medium transition">
        Iniciar sesion
      </a>
    </div>
  </div>
</Layout>
